server {
    server_name codexcolor.com www.codexcolor.com;

       # Add error logging for debugging
error_log /var/log/nginx/codexcolor_error.log;

    root /var/www/codexcolor;
    index index.php index.html index.htm;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
    }

    location ~ /\.ht {
        deny all;
    }

       # ======= GTM MAIN SERVER =======
    location /sgtm/ {
        # Strip the /sgtm/ prefix and forward the remainder (keeps query string)
        proxy_pass http://127.0.0.1:8080/;

        # Preserve query string explicitly
        proxy_pass_request_headers on;
        proxy_pass_request_body on;

        # Critical headers for GTM authentication and functionality
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Forward original request uri for debugging upstream issues
        proxy_set_header X-Original-URI $request_uri;

        # Pass through specific headers
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Accept $http_accept;
        proxy_set_header Accept-Language $http_accept_language;
        proxy_set_header Accept-Encoding $http_accept_encoding;
        proxy_set_header Referer $http_referer;
        proxy_set_header Cookie $http_cookie;

        # GTM authentication headers - CRITICAL
        proxy_set_header gtm-auth $http_gtm_auth;
        proxy_set_header gtm-preview $http_gtm_preview;

        # Pass through Authorization headers
        proxy_set_header Authorization $http_authorization;

        # Additional headers for POST requests
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Content-Length $content_length;

        # Remove any conflicting headers from backend
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;

        # Add CORS headers for browser requests - use * for broader compatibility during debugging
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, HEAD" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin, User-Agent, X-Requested-With, gtm-auth, gtm-preview, Cookie" always;

        # Buffer settings
        proxy_buffering on;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
        proxy_max_temp_file_size 2m;

        # Timeout settings - increase for debug mode
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Error handling
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_redirect off;

        # Handle OPTIONS preflight requests
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, HEAD" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin, User-Agent, X-Requested-With, gtm-auth, gtm-preview, Cookie" always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }
    }

    # ======= GTM PREVIEW SERVER =======
    location /sgtm-preview/ {
        proxy_pass http://127.0.0.1:8081/;
        
        proxy_pass_request_headers on;
        proxy_pass_request_body on;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Original-URI $request_uri;
        
        # CORS headers for preview
        add_header Access-Control-Allow-Origin "$http_origin" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin, User-Agent, Cookie" always;
        
        # Buffer and timeout settings
        proxy_buffering on;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Handle OPTIONS for preview
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin "$http_origin" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin, User-Agent, Cookie" always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/codexcolor.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/codexcolor.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = www.codexcolor.com) {
        return 301 https://$host$request_uri;
    }

    if ($host = codexcolor.com) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name codexcolor.com www.codexcolor.com;
    return 404;
}
